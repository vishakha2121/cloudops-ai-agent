build/
dist/
out/
target/
*.tsbuildinfo

# ============================================
# Temporary files
# ============================================
*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej
tmp/
temp/
.cache/

# ============================================
# ML Models (large files - use Git LFS or ignore)
# ============================================
*.h5
*.pkl
*.joblib
*.model
*.weights
*.pt
*.pth
*.onnx
ml_models/cache/
ml_models/trained/

# ============================================
# Data files (may contain sensitive info)
# ============================================
*.csv
*.parquet
*.feather
*.arrow
data/raw/
data/processed/
!database/seeds/*.sql

# ============================================
# Package managers
# ============================================
package-lock.json
yarn.lock
pnpm-lock.yaml
poetry.lock
Pipfile.lock

# ============================================
# Keep these files (whitelist)
# ============================================
!.gitignore
!.env.example
!README.md
!LICENSE
!.gitkeep
!database/backups/.gitkeep
# ============================================
# CLOUDOPS AI AGENT — .gitignore
# ============================================

